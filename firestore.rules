rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.uid in [
          "NioS8nIm2RZQnK8XzEQK06YhXwE2"
        ];
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /meals/{mealId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
