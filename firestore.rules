rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.uid in [
          "NioS8nIm2RZQnK8XzEQK06YhXwE2"
        ];
    }

    function ownsList(listId) {
      return request.auth != null
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    // Legacy top-level catalog. Keep this during the staged list migration.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /meals/{mealId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // List metadata is private to approved editors. Public planner reads do not
    // need the parent list document; they read the nested catalog directly.
    match /lists/{listId} {
      allow read: if isEditor();
      allow create: if isEditor()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isEditor()
        && resource.data.ownerUid == request.auth.uid;

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if isEditor() && ownsList(listId);
      }

      match /meals/{mealId} {
        allow read: if true;
        allow create, update, delete: if isEditor() && ownsList(listId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
