rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.uid in [
          "NioS8nIm2RZQnK8XzEQK06YhXwE2"
        ];
    }

    function ownsList(listId) {
      return request.auth != null
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function canReadList(listId) {
      return ownsList(listId)
        || get(/databases/$(database)/documents/lists/$(listId)).data.publicRead == true;
    }

    // Legacy top-level catalog. Keep this during the staged list migration.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /meals/{mealId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // During the staged migration, the existing allowlisted editor may inspect
    // and populate a list before its parent list document exists. Once created,
    // normal owner-based access applies as well.
    match /lists/{listId} {
      allow read: if isEditor() || ownsList(listId);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isEditor() || (
        ownsList(listId)
        && request.resource.data.ownerUid == resource.data.ownerUid
      );
      allow delete: if isEditor() || ownsList(listId);

      match /categories/{categoryId} {
        allow read: if isEditor() || canReadList(listId);
        allow create, update, delete: if isEditor() || ownsList(listId);
      }

      match /meals/{mealId} {
        allow read: if isEditor() || canReadList(listId);
        allow create, update, delete: if isEditor() || ownsList(listId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
