rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsList(listId) {
      return request.auth != null
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function canReadList(listId) {
      return ownsList(listId)
        || get(/databases/$(database)/documents/lists/$(listId)).data.publicRead == true;
    }

    match /lists/{listId} {
      // List metadata stays private to the owner. A publicRead list exposes only
      // its nested catalog, not owner metadata on the list document itself.
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /categories/{categoryId} {
        allow read: if canReadList(listId);
        allow create, update, delete: if ownsList(listId);
      }

      match /meals/{mealId} {
        allow read: if canReadList(listId);
        allow create, update, delete: if ownsList(listId);
      }
    }

    // Legacy top-level categories/meals remain in Firestore as an inert backup.
    // No application access is granted to them by these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
